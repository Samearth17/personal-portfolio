{
  "name": "samarth-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.portfolio.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.html *.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html *.md",
    "check": "npm run typecheck && npm test && npm run build && node scripts/verify-build.mjs",
    "build": "tsc --noEmit && vite build --config vite.portfolio.config.ts",
    "preview": "vite preview --config vite.portfolio.config.ts --host 127.0.0.1 --port 5221"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
